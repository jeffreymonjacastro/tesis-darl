{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LaTeX: watch build",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-pvc",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "main.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/thesis"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
